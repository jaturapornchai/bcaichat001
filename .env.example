# Server
PORT=8096
RUST_LOG=info

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27030
MONGODB_DB=bcaichat

# MinIO Object Storage
MINIO_ENDPOINT=http://127.0.0.1:9130
MINIO_ACCESS_KEY=bcaichatadmin
MINIO_SECRET_KEY=bcaichat_minio_local_dev
MINIO_BUCKET=bcaichat-storage

# Auth, Phone OTP (SMSMKT) & Google OAuth2
JWT_SECRET=replace_with_your_64_char_secret_key_in_local_env
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SMSMKT_BASE_URL=https://portal-otp.smsmkt.com
SMSMKT_API_KEY=your_smsmkt_api_key_here
SMSMKT_SECRET_KEY=your_smsmkt_secret_key_here
SMSMKT_PROJECT_KEY=your_smsmkt_otp_project_key_here
SMSMKT_SENDER_NAME=SMS-Alert
SMSMKT_MCP_BEARER=your_smsmkt_mcp_bearer_here
ADMIN_BOOTSTRAP_CODE=your_admin_bootstrap_code_here
# Quick Test / Demo Users: strictly localhost/loopback ONLY (localhost, 127.0.0.1, [::1], 10.0.2.2, oa.localhost); HARD-BLOCKED on external domains even if set true
ENABLE_TEST_USERS=false

# LiveKit SFU Voice & Video Calls
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=bcaichat_lk_dev_key
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# BC AI Assistant (Server-managed secret config in .env ONLY; never exposed to client UI)
AI_BASE_URL=https://ollama.com
AI_MODEL=deepseek-v4.1-flash
AI_API_KEY=your_ollama_cloud_api_key_here
AI_TIMEOUT_SECS=60
AI_ENABLED=true
AI_GAME_PROACTIVE_ENABLED=true
AI_GAME_HOST_POLL_SECS=60
AI_GAME_TRIGGER_MSGS=12

# Push Alerts (Firebase Cloud Messaging) - leave empty to keep push off
FCM_SERVICE_ACCOUNT_FILE=

# ElevenLabs TTS (read locally at runtime for video generation; never commit real keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
